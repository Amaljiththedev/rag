# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Application Settings
PROJECT_NAME="RAG Production Assistant"
ENV="development"
DEBUG=True

# Database (PostgreSQL + pgvector, started by docker-compose)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="rag_user"
POSTGRES_PASSWORD="rag_password"
POSTGRES_DB="rag_db"
DATABASE_URL="postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_db"

# LLM & Embeddings Configuration
# LLM_PROVIDER: groq or openai
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_API_KEY=""
# Embeddings run locally via sentence-transformers; 384 dims must match the
# vector(384) column on the chunks table.
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Retrieval & Ingestion Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_VECTOR=10
TOP_K_KEYWORD=10
TOP_K_HYBRID=5
CONFIDENCE_THRESHOLD=0.7

# Frontend origins allowed to call this API (comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100"
