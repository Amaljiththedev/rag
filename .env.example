# Application Settings
PROJECT_NAME="RAG Production Assistant"
ENV="development"
DEBUG=True





# Database (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="rag_user"
POSTGRES_PASSWORD="rag_password"
POSTGRES_DB="rag_db"
DATABASE_URL="postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_db"

# LLM & Embeddings Configuration
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx"
EMBEDDING_MODEL="text-embedding-3-small"
LLM_MODEL="gpt-4o"
LLM_PROVIDER="openai" # openai, azure, anthropic

# Retrieval & Ingestion Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_VECTOR=10
TOP_K_KEYWORD=10
TOP_K_HYBRID=5
CONFIDENCE_THRESHOLD=0.7
